# Base Dockerfile for Laravel Services
FROM php:8.2-fpm

ARG MONGODB_EXTENSION_VERSION=2.1.4

# Install everything in one layer for faster builds
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpng-dev libonig-dev libxml2-dev libzip-dev \
    libssl-dev libcurl4-openssl-dev pkg-config \
    nginx supervisor \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip \
    && pecl install mongodb-${MONGODB_EXTENSION_VERSION} redis \
    && docker-php-ext-enable mongodb redis \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy Composer from official image
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Configure PHP, nginx, and supervisor in one layer
RUN cp /usr/local/etc/php/php.ini-production /usr/local/etc/php/php.ini \
    && sed -i 's/memory_limit = .*/memory_limit = 512M/' /usr/local/etc/php/php.ini \
    && sed -i 's/upload_max_filesize = .*/upload_max_filesize = 100M/' /usr/local/etc/php/php.ini \
    && sed -i 's/post_max_size = .*/post_max_size = 100M/' /usr/local/etc/php/php.ini \
    && sed -i 's/max_execution_time = .*/max_execution_time = 300/' /usr/local/etc/php/php.ini \
    && cat > /etc/nginx/sites-available/default <<'NGINX'
server {
    listen 80;
    server_name _;
    root /var/www/html/public;
    index index.php index.html;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.ht {
        deny all;
    }
}
NGINX
    \
    && printf '[supervisord]\nnodaemon=true\nuser=root\n\n[program:php-fpm]\ncommand=/usr/local/sbin/php-fpm -F\nautostart=true\nautorestart=true\n\n[program:nginx]\ncommand=/usr/sbin/nginx -g "daemon off;"\nautostart=true\nautorestart=true\n' > /etc/supervisor/conf.d/supervisord.conf

WORKDIR /var/www/html

# Copy application code from build context
COPY --from=app . /var/www/html

# Verify MongoDB extension is loaded before composer operations
RUN php -m | grep -i mongodb || (echo "ERROR: MongoDB extension not loaded!" && exit 1)

# Update MongoDB dependencies first to prevent lock file mismatches
RUN composer update mongodb/mongodb mongodb/laravel-mongodb --no-dev --no-interaction \
    --ignore-platform-req=ext-mongodb --ignore-platform-req=ext-ldap --ignore-platform-req=php-64bit \
    --with-all-dependencies 2>/dev/null || true

# Install dependencies and set permissions in one layer
RUN composer install --no-dev --optimize-autoloader --no-interaction \
    --ignore-platform-req=ext-mongodb --ignore-platform-req=ext-ldap --ignore-platform-req=php-64bit \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 80
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
